/E (    // State transition logic     always @\(posedge clk or negedge rst\) begin         if \(~rst\)             state <= IDLE;  // Reset to Idle state         else begin             case \(state\)                 IDLE: begin                     if \(up_button\)                         state <= UP;  // Move up if the up button is pressed                     else if \(down_button\)                         state <= DOWN;  // Move down if the down button is pressed                 end                 UP: begin                     if \(~up_button\)                         state <= IDLE;  // Return to Idle if the up button is released                 end                 DOWN: begin                     if \(~down_button\)                         state <= IDLE;  // Return to Idle if the down button is released                 end             endcase         end     end)
/Alt ()
/Pg 29 0 R
/K [2]
