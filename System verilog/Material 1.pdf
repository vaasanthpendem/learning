/E (    // Write logic     always @\(posedge wr_clk or posedge rst\) begin         if \(rst\) begin             wr_ptr_bin  <= 0;             wr_ptr_gray <= 0;         end else if \(wr_en && !full\) begin             mem[wr_ptr_bin[ADDR_WIDTH-1:0]] <= wr_data;             wr_ptr_bin  <= wr_ptr_bin + 1;             wr_ptr_gray <= \(wr_ptr_bin + 1\) ^ \(\(wr_ptr_bin + 1\) >> 1\);         end     end)
