/T (    always @\(posedge clk or negedge rst\) begin         if \(~rst\) begin             write_ptr <= 4'b0000; // Reset write pointer             read_ptr <= 4'b0000;  // Reset read pointer             full <= 1'b0;             empty <= 1'b1;             ack_in <= 1'b0;             valid_out <= 1'b0;         end else begin             // FIFO write operation with handshaking             if \(valid_in && !full\) begin                 fifo[write_ptr] <= data_in;  // Store data in FIFO                 write_ptr <= write_ptr + 1;  // Increment write pointer                 full <= \(write_ptr == 4'b1111\);  // Check for overflow                 empty <= 1'b0;                 ack_in <= 1'b1;  // Acknowledge that data is written             end else begin                 ack_in <= 1'b0;             end        )
/E (    always @\(posedge clk or negedge rst\) begin         if \(~rst\) begin             write_ptr <= 4'b0000; // Reset write pointer             read_ptr <= 4'b0000;  // Reset read pointer             full <= 1'b0;             empty <= 1'b1;             ack_in <= 1'b0;             valid_out <= 1'b0;         end else begin             // FIFO write operation with handshaking             if \(valid_in && !full\) begin                 fifo[write_ptr] <= data_in;  // Store data in FIFO                 write_ptr <= write_ptr + 1;  // Increment write pointer                 full <= \(write_ptr == 4'b1111\);  // Check for overflow                 empty <= 1'b0;                 ack_in <= 1'b1;  // Acknowledge that data is written             end else begin                 ack_in <= 1'b0;             end        )
/Alt ()
/Pg 34 0 R
/K [3]
>>
