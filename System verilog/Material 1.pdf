/T (    always @\(*\) begin         // Majority voter         out = \(out1 & out2\) | \(out2 & out3\) | \(out1 & out3\);         // Fault detection if outputs are not all equal         fault_detected = \(out1 != out2\) || \(out2 != out3\) || \(out1 != out3\);     end endmodule)
/E (    always @\(*\) begin         // Majority voter         out = \(out1 & out2\) | \(out2 & out3\) | \(out1 & out3\);         // Fault detection if outputs are not all equal         fault_detected = \(out1 != out2\) || \(out2 != out3\) || \(out1 != out3\);     end endmodule)
